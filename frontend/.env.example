# ============================================================================
# FreightSentinel — frontend environment variables / 前端环境变量
# ----------------------------------------------------------------------------
# NEVER put an AI API key here. Anything the frontend knows can be read by any
# visitor. The key stays on the backend server only.
# 前端绝不放 AI API key。前端拿到的东西访问者都能看到，密钥只放后端。
# ============================================================================

# URL of the FastAPI backend, no trailing slash.
# 后端地址，结尾不要带斜杠。
# Local / 本地:  http://localhost:8000
# Cloud / 云端:  https://<your-service>.onrender.com
#   Vercel → Project → Settings → Environment Variables → BACKEND_URL
BACKEND_URL=http://localhost:8000
