# ============================================================================
# FreightSentinel — backend environment variables / 后端环境变量
# ----------------------------------------------------------------------------
# Local  / 本地：cp backend/.env.example backend/.env  然后填 AI_API_KEY
#                backend/.env is gitignored / 已被 .gitignore 忽略，绝不提交
# Cloud  / 云端：DO NOT upload this file. Put every value below into the host's
#                Environment Variables panel (Render → Service → Environment).
#                不要上传本文件，所有值填到 Render 的 Environment 面板里。
#
# The API key lives ONLY on the backend. It is never sent to the frontend,
# never printed in logs, never committed.
# API key 只存在于后端服务器，不进前端、不进日志、不进仓库。
# ============================================================================

# --- Required / 必填 --------------------------------------------------------

# AI provider: deepseek | openai | anthropic | gemini | none
# 使用哪家 AI。比赛配置为 deepseek。none = 关闭分析。
AI_PROVIDER=deepseek

# Provider API key. Leave EMPTY in this example file.
# 供应商密钥。本示例文件永远留空；本地填进 backend/.env，云端填进 Render 面板。
AI_API_KEY=

# Model name. Empty = provider default (see app/config.py DEFAULT_MODELS).
# 模型名。留空则用默认值。比赛配置：deepseek-flash
AI_MODEL=deepseek-flash

# --- Analysis behaviour / 分析行为 ------------------------------------------

# full = AI makes every business decision; off = analysis disabled.
# full = 所有业务判断交给 AI（正式配置）；off = 停用分析。
AI_MODE=full

# Extended thinking on the primary model / 主模型开启思考
AI_THINKING=true

# Thinking effort: low | high | max  (medium is mapped to high)
# 思考强度。比赛配置：主模型 high
AI_REASONING_EFFORT=high

# Seconds before one AI call is abandoned / 单次调用超时秒数
AI_TIMEOUT=240

# Same-provider backup model used while the primary returns 429/503.
# 主模型限流/过载时的同厂备用模型。none = 不启用（比赛配置）。
AI_FALLBACK_MODEL=none

# Requests per minute per model. Empty = provider default (Gemini free tier 15).
# 0 = no pacing (paid tier). / 每分钟请求上限。0 = 不限速（付费额度）。
AI_MAX_RPM=

# Parallel analyses during a batch run / 批量跑全收件箱时的并发数
BATCH_CONCURRENCY=4

# AI review guidance: standard | strict  (not a hard confidence threshold)
# 给 AI 的复核尺度，不是程序写死的置信度门槛。
AUTOMATION_POLICY=standard

# --- Senior stage (second pass) / 资深复核阶段 ------------------------------
# Uncertain primary results are reviewed once by this model, then go to a human.
# 主模型判不准的个案，由这里配置的模型复核一次，仍不确定就转人工。
# Leave AI_SENIOR_MODEL blank to disable / 留空即停用该阶段。

AI_SENIOR_PROVIDER=deepseek
AI_SENIOR_MODEL=deepseek-flash
# Blank reuses AI_API_KEY when the provider matches.
# 与主模型同厂时留空即复用 AI_API_KEY；不同厂才需要单独填。
AI_SENIOR_API_KEY=
AI_SENIOR_THINKING=true
AI_SENIOR_REASONING_EFFORT=max
AI_SENIOR_TIMEOUT=240
AI_SENIOR_MAX_RPM=0

# --- Networking & data / 网络与数据 -----------------------------------------

# Browsers allowed to call the API directly. The Vercel frontend proxies
# /api/* server-side, so "*" is only needed for direct testing.
# 允许直连 API 的来源。前端走服务端代理，一般无需放开。
CORS_ORIGINS=*

# Optional overrides — defaults are fine / 一般不用改
# DATA_ZIP=data/sdoc-hackathon-bundle.zip
# DATA_DIR=backend/.data/bundle
# CACHE_DIR=backend/.cache
