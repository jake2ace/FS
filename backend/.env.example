# Copy to backend/.env for local runs (never commit real keys).
AI_PROVIDER=none          # openai | anthropic | gemini | none
AI_API_KEY=
AI_MODEL=                 # optional; defaults: gpt-4.1-mini / claude-3-5-haiku-latest / gemini-2.5-flash
AI_MODE=full              # full | assist | off
BATCH_CONCURRENCY=4
CORS_ORIGINS=*
AUTOMATION_POLICY=standard
